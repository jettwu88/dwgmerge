# Copy this to .streamlit/secrets.toml for local runs, or paste the same
# keys into the "Secrets" box in Streamlit Community Cloud's app settings
# (Settings -> Secrets). Both are OPTIONAL - without this section the app
# still works, it just stores the base template (A) locally instead of
# syncing it to GitHub, so it resets whenever the app restarts/redeploys.

[github]
# A GitHub Personal Access Token, fine-grained, scoped to ONLY this one
# repo, with Contents: Read and write permission. Create one at
# https://github.com/settings/personal-access-tokens/new
token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# "your-github-username-or-org/your-repo-name"
repo = "your-org/dwgmerge"

# Where inside that repo the shared template file lives.
path = "current_template.dxf"

# Branch to commit updates to.
branch = "main"
